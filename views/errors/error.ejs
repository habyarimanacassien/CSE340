<!-- Page Heading -->
<% if (title) { %>
    <h1 class="error-title">
        <%= title %>
    </h1>
    <% } else { %>
        <h1 class="error-title">Server Error</h1>
        <% } %>

<!-- Lego Error Section -->
<div id="error-container">

    <!-- Lego figure made with CSS/HTML characters -->
    <div id="lego-figure" aria-hidden="true">
        <div class="lego-head">
            <div class="lego-stud"></div>
            <div class="lego-face">
                <span class="lego-eye left"></span>
                <span class="lego-eye right"></span>
                <span class="lego-mouth">&#8255;</span>
            </div>
        </div>
        <div class="lego-body">
            <div class="lego-arm left-arm"></div>
            <div class="lego-torso">
                <span class="lego-badge">!</span>
            </div>
            <div class="lego-arm right-arm"></div>
        </div>
        <div class="lego-legs">
            <div class="lego-leg left-leg"></div>
            <div class="lego-leg right-leg"></div>
        </div>
    </div>

    <!-- Message Block -->
    <div id="error-message-block">
        <div class="error-detail"><%- message %></div>
        <a href="/" class="error-home-btn">&#127968; Take me home</a>
    </div>

</div>