<h1><%= title %></h1>

<%- messages() %>

<% if (errors) { %>
<ul class="errors">
<% errors.array().forEach(error => { %>
    <li><%= error.msg %></li>
<% }) %>
</ul>
<% } %>

<div id="account-update-container">

  <!-- ==============================
       FORM 1: Account Information Update
       ============================== -->
  <section class="update-section">
    <h2>Update Account Information</h2>

    <form id="accountUpdateForm" action="/account/update/" method="post" novalidate>

      <div class="form-group">
        <label for="account_firstname">First Name <span class="required">*</span></label>
        <input
          type="text"
          id="account_firstname"
          name="account_firstname"
          required
          minlength="1"
          autocomplete="given-name"
          value="<%= locals.account_firstname %>"
        />
      </div>

      <div class="form-group">
        <label for="account_lastname">Last Name <span class="required">*</span></label>
        <input
          type="text"
          id="account_lastname"
          name="account_lastname"
          required
          minlength="2"
          autocomplete="family-name"
          value="<%= locals.account_lastname %>"
        />
      </div>

      <div class="form-group">
        <label for="account_email">Email Address <span class="required">*</span></label>
        <input
          type="email"
          id="account_email"
          name="account_email"
          required
          autocomplete="email"
          value="<%= locals.account_email %>"
        />
      </div>

      <!-- Hidden: passes account_id with the form -->
      <input type="hidden" name="account_id" value="<%= locals.account_id %>">

      <button type="submit" class="btn-submit">Update Account</button>

    </form>
  </section>

  <!-- ==============================
       FORM 2: Change Password (completely separate)
       ============================== -->
  <section class="update-section">
    <h2>Change Password</h2>

    <p class="password-notice">
      <strong>Note:</strong> Entering a new password below will replace your current password.
      Your password must meet all of the following requirements:
    </p>
    <ul class="password-requirements">
      <li>At least 12 characters long</li>
      <li>At least one uppercase letter (A–Z)</li>
      <li>At least one lowercase letter (a–z)</li>
      <li>At least one number (0–9)</li>
      <li>At least one special character (e.g. !@#$%)</li>
    </ul>

    <form id="passwordChangeForm" action="/account/change-password/" method="post" novalidate>

      <div class="form-group">
        <label for="account_password">New Password <span class="required">*</span></label>
        <input
          type="password"
          id="account_password"
          name="account_password"
          required
          minlength="12"
          autocomplete="new-password"
          placeholder="Enter a new password"
        />
      </div>

      <!-- Hidden: passes account_id with the form -->
      <input type="hidden" name="account_id" value="<%= locals.account_id %>">

      <button type="submit" class="btn-submit">Change Password</button>

    </form>
  </section>

  <p><a href="/account/">&larr; Back to Account Management</a></p>

</div>

<script>
  /* ── Client-side validation for Account Update form ── */
  (function () {
    const form = document.getElementById("accountUpdateForm");
    form.addEventListener("submit", function (e) {
      let valid = true;

      const firstname = document.getElementById("account_firstname");
      const lastname  = document.getElementById("account_lastname");
      const email     = document.getElementById("account_email");

      if (!firstname.value.trim()) {
        firstname.setCustomValidity("First name is required.");
        valid = false;
      } else {
        firstname.setCustomValidity("");
      }

      if (!lastname.value.trim() || lastname.value.trim().length < 2) {
        lastname.setCustomValidity("Last name must be at least 2 characters.");
        valid = false;
      } else {
        lastname.setCustomValidity("");
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email.value.trim())) {
        email.setCustomValidity("Please enter a valid email address.");
        valid = false;
      } else {
        email.setCustomValidity("");
      }

      if (!valid) {
        e.preventDefault();
        form.reportValidity();
        return;
      }

      // Confirmation before saving account changes
      const fnEl = document.getElementById("account_firstname");
      const name = fnEl ? fnEl.value.trim() : "your account";
      const confirmed = window.confirm(
        "Are you sure you want to update the account information for \"" + name + "\"?\n\nClick OK to save, or Cancel to go back."
      );
      if (!confirmed) { e.preventDefault(); }
    });
  })();

  /* ── Client-side validation for Password Change form ── */
  (function () {
    const form = document.getElementById("passwordChangeForm");
    form.addEventListener("submit", function (e) {
      const pwd = document.getElementById("account_password");
      const strongPwd = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{12,}$/;

      if (!strongPwd.test(pwd.value)) {
        pwd.setCustomValidity(
          "Password must be 12+ characters with uppercase, lowercase, number, and special character."
        );
        e.preventDefault();
        form.reportValidity();
        return;
      } else {
        pwd.setCustomValidity("");
      }

      // Confirmation before changing password
      const ok = window.confirm(
        "Are you sure you want to change your password?\n\nClick OK to confirm, or Cancel to go back."
      );
      if (!ok) { e.preventDefault(); }
    });
  })();
</script>
