<h1><%= title %></h1>

<%# Display flash messages if any %>
<%- messages() %>

<%# Display errors if any %>
<% if (errors) { %>
<ul class="errors">
<% errors.array().forEach(error=> { %>
    <li><%= error.msg %></li>
<% }) %>
</ul>
<% } %>

<div id="account-management">

    <% if (locals.accountData) { %>
      <% if (accountData.account_type === "Employee" || accountData.account_type === "Admin") { %>
        <h2>Welcome <%= accountData.account_firstname %></h2>
      <% } else { %>
        <p class="account-greeting">Welcome, <%= accountData.account_firstname %></p>
      <% } %>
    <% } %>

    <%# Update Account Info link — visible to all logged-in users %>
    <% if (locals.accountData) { %>
        <p><a href="/update/<%= accountData.account_id %>">Update Account Information</a></p>
        <p><a href="/favorites/">&#9829; My Saved Favorites</a></p>
    <% } %>

    <%# Inventory management — Employee and Admin only %>
    <% if (locals.accountData &&
           (accountData.account_type === "Employee" || accountData.account_type === "Admin")) { %>
        <h3>Inventory Management</h3>
        <p><a href="/inv/">Manage Inventory</a></p>
    <% } %>

</div>
