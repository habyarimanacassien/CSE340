<h1>
    <%= title %>
</h1>

<%# Display flash messages if any %>
<%- messages() %>

<%# Display errors if any %>
<% if (errors) { %>
<ul class="errors">
<% errors.array().forEach(error=> { %>
    <li>
        <%= error.msg %>
    </li>
    <% }) %>
</ul>
<% } %>

<div id="account-management">
    <p>You're logged in.</p>
</div>