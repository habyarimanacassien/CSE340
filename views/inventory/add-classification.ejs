<h1><%= title %></h1>

<%# Display flash messages %>
<%- messages() %>

<%# Display server-side validation errors %>
<% if (errors) { %>
  <ul class="errors">
    <% errors.forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<div id="add-classification-container">
  <form action="/inv/add-classification" method="post" id="addClassificationForm" novalidate>
    <fieldset>
      <legend>Add a New Classification</legend>

      <p class="notice">
        Classification name must contain only letters and/or numbers.
        <strong>No spaces or special characters are allowed.</strong>
      </p>

      <label for="classification_name">Classification Name:</label>
      <input
        type="text"
        name="classification_name"
        id="classification_name"
        required
        pattern="^[a-zA-Z0-9]+$"
        title="No spaces or special characters allowed"
        placeholder="e.g. Sedan or SUV"
        value="<%= typeof classification_name != 'undefined' ? classification_name : '' %>"
      >

      <button type="submit">Add Classification</button>
    </fieldset>
  </form>

  <p><a href="/inv/">Back to Management</a></p>
</div>

<script>
  /* Client-side validation */
  const form = document.getElementById("addClassificationForm")
  form.addEventListener("submit", function (e) {
    const nameInput = document.getElementById("classification_name")
    const value = nameInput.value.trim()
    const pattern = /^[a-zA-Z0-9]+$/

    if (!pattern.test(value)) {
      e.preventDefault()
      alert("Classification name cannot contain spaces or special characters.")
      nameInput.focus()
    }
  })
</script>
