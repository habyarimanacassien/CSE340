<h1><%= title %></h1>

<%- messages() %>

<% if (errors) { %>
<ul class="errors">
<% errors.forEach(error=> { %>
    <li><%= error.msg %></li>
<% }) %>
</ul>
<% } %>

<div id="add-inventory-container">
    <p class="notice"><strong>Confirm Deletion — The delete is permanent and cannot be undone.</strong></p>

    <form action="/inv/delete" method="post" id="deleteForm">
        <fieldset>
            <legend>Confirm Vehicle Deletion</legend>

            <div class="form-field">
                <label for="inv_make">Make</label>
                <div class="input-wrap">
                    <input type="text" name="inv_make" id="inv_make" readonly
                        value="<%= locals.inv_make %>">
                </div>
            </div>

            <div class="form-field">
                <label for="inv_model">Model</label>
                <div class="input-wrap">
                    <input type="text" name="inv_model" id="inv_model" readonly
                        value="<%= locals.inv_model %>">
                </div>
            </div>

            <div class="form-field">
                <label for="inv_year">Year</label>
                <div class="input-wrap">
                    <input type="number" name="inv_year" id="inv_year" readonly
                        value="<%= locals.inv_year %>">
                </div>
            </div>

            <div class="form-field">
                <label for="inv_price">Price (USD)</label>
                <div class="input-wrap">
                    <input type="number" name="inv_price" id="inv_price" readonly
                        value="<%= locals.inv_price %>">
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" id="deleteBtn">Delete Vehicle</button>
                <a href="/inv/" class="form-cancel-link">Cancel</a>
            </div>

            <input type="hidden" name="inv_id"
                <% if(locals.inv_id) { %> value="<%= locals.inv_id %>" <% } %>>

        </fieldset>
    </form>
</div>

<script>
  /* Confirmation prompt before permanent deletion */
  const deleteForm = document.getElementById("deleteForm")
  if (deleteForm) {
    deleteForm.addEventListener("submit", function (e) {
      const make  = document.getElementById("inv_make")  ? document.getElementById("inv_make").value  : "this vehicle"
      const model = document.getElementById("inv_model") ? document.getElementById("inv_model").value : ""
      const name  = (make && model) ? `${make} ${model}` : "this vehicle"

      const confirmed = window.confirm(
        `⚠️ WARNING: You are about to permanently delete "${name}".\n\nThis action CANNOT be undone. Are you absolutely sure?\n\nClick OK to delete, or Cancel to go back.`
      )
      if (!confirmed) {
        e.preventDefault()
      }
    })
  }
</script>
