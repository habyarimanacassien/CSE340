<h1>
  <%= title %>
</h1>

<%- messages() %>

  <% if (errors) { %>
    <ul class="errors">
      <% errors.forEach(error=> { %>
        <li>
          <%= error.msg %>
        </li>
        <% }) %>
    </ul>
    <% } %>

      <div id="add-inventory-container">
        <form action="/inv/add-inventory" method="post" id="addInventoryForm" novalidate>
          <fieldset>
            <legend>Add a New Vehicle</legend>

            <div class="form-field">
              <label for="classificationList">Classification</label>
              <div class="input-wrap select-wrap">
                <%- classificationList %>
                  <span class="field-hint">Select the vehicle category</span>
              </div>
            </div>

            <div class="form-field">
              <label for="inv_make">Make</label>
              <div class="input-wrap">
                <input type="text" name="inv_make" id="inv_make" required minlength="3" autocomplete="off"
                  placeholder="e.g. Toyota" value="<%= typeof inv_make != 'undefined' ? inv_make : '' %>">
                <span class="field-hint">Minimum 3 characters</span>
              </div>
            </div>

            <div class="form-field">
              <label for="inv_model">Model</label>
              <div class="input-wrap">
                <input type="text" name="inv_model" id="inv_model" required minlength="3" autocomplete="off"
                  placeholder="e.g. Camry" value="<%= typeof inv_model != 'undefined' ? inv_model : '' %>">
                <span class="field-hint">Minimum 3 characters</span>
              </div>
            </div>

            <div class="form-field">
              <label for="inv_year">Year</label>
              <div class="input-wrap">
                <input type="number" name="inv_year" id="inv_year" required min="1900" max="2099"
                  placeholder="e.g. 2023" value="<%= typeof inv_year != 'undefined' ? inv_year : '' %>">
                <span class="field-hint">Between 1900 and 2099</span>
              </div>
            </div>

            <div class="form-field">
              <label for="inv_description">Description</label>
              <div class="input-wrap">
                <textarea name="inv_description" id="inv_description" required
                  placeholder="Describe the vehicle — features, condition, history..."><%= typeof inv_description != 'undefined' ? inv_description : '' %></textarea>
                <span class="field-hint">Required</span>
              </div>
            </div>

            <div class="form-field">
              <label for="inv_image">Image Path</label>
              <div class="input-wrap">
                <input type="text" name="inv_image" id="inv_image" required placeholder="/images/vehicles/no-image.png"
                  value="<%= typeof inv_image != 'undefined' ? inv_image : '/images/vehicles/no-image.png' %>">
                <span class="field-hint">Relative path to full-size image</span>
              </div>
            </div>

            <div class="form-field">
              <label for="inv_thumbnail">Thumbnail Path</label>
              <div class="input-wrap">
                <input type="text" name="inv_thumbnail" id="inv_thumbnail" required
                  placeholder="/images/vehicles/no-image-tn.png"
                  value="<%= typeof inv_thumbnail != 'undefined' ? inv_thumbnail : '/images/vehicles/no-image-tn.png' %>">
                <span class="field-hint">Relative path to thumbnail image</span>
              </div>
            </div>

            <div class="form-field">
              <label for="inv_price">Price (USD)</label>
              <div class="input-wrap">
                <input type="number" name="inv_price" id="inv_price" required min="0" step="0.01"
                  placeholder="e.g. 25000" value="<%= typeof inv_price != 'undefined' ? inv_price : '' %>">
                <span class="field-hint">Whole number or decimal, minimum 0</span>
              </div>
            </div>

            <div class="form-field">
              <label for="inv_miles">Miles</label>
              <div class="input-wrap">
                <input type="number" name="inv_miles" id="inv_miles" required min="0" placeholder="e.g. 15000"
                  value="<%= typeof inv_miles != 'undefined' ? inv_miles : '' %>">
                <span class="field-hint">Total odometer reading, minimum 0</span>
              </div>
            </div>

            <div class="form-field">
              <label for="inv_color">Color</label>
              <div class="input-wrap">
                <input type="text" name="inv_color" id="inv_color" required minlength="3" autocomplete="off"
                  placeholder="e.g. Midnight Blue" value="<%= typeof inv_color != 'undefined' ? inv_color : '' %>">
                <span class="field-hint">Minimum 3 characters</span>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" id="submitBtn">Add Vehicle</button>
              <a href="/inv/" class="form-cancel-link">Cancel</a>
            </div>

          </fieldset>
        </form>
      </div>

      <script>
        const form = document.getElementById("addInventoryForm")

        function validateField(el) {
          const wrap = el.closest(".input-wrap")
          if (!wrap) return
          const tag = el.tagName.toLowerCase()

          let ok = false

          if (tag === "select") {
            ok = el.value !== ""
          } else if (tag === "textarea") {
            ok = el.value.trim().length > 0
          } else if (el.type === "number") {
            const val = parseFloat(el.value)
            const min = el.hasAttribute("min") ? parseFloat(el.getAttribute("min")) : -Infinity
            const max = el.hasAttribute("max") ? parseFloat(el.getAttribute("max")) : Infinity
            ok = !isNaN(val) && val >= min && val <= max
          } else {
            const min = el.hasAttribute("minlength") ? parseInt(el.getAttribute("minlength")) : 1
            ok = el.value.trim().length >= min
          }

          wrap.classList.toggle("field-valid", ok)
          wrap.classList.toggle("field-invalid", !ok)
        }

        document.querySelectorAll(
          "#addInventoryForm input, #addInventoryForm textarea, #addInventoryForm select"
        ).forEach(el => {
          el.addEventListener("input", () => validateField(el))
          el.addEventListener("change", () => validateField(el))
          el.addEventListener("blur", () => {
            if (el.value !== "") validateField(el)
          })
        })

        form.addEventListener("submit", function (e) {
          let valid = true

          document.querySelectorAll(
            "#addInventoryForm input[required], #addInventoryForm textarea[required], #addInventoryForm select[required]"
          ).forEach(el => {
            validateField(el)
            const wrap = el.closest(".input-wrap")
            if (wrap && wrap.classList.contains("field-invalid")) valid = false
            if (wrap && !wrap.classList.contains("field-valid") && !wrap.classList.contains("field-invalid")) {
              validateField(el)
              if (wrap.classList.contains("field-invalid")) valid = false
            }
          })

          if (!valid) e.preventDefault()
        })
      </script>